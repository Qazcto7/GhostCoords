{
  "schemaVersion": 1,
  "id": "ghostcoords",
  "version": "${version}",
  "name": "GhostCoords",
  "description": "Client-side death coordinate tracker that privately shows your last death location in chat via /killinfo or /ghostcoords. Works in Singleplayer & Multiplayer.",
  "authors": [
    "Kazim"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/ghostcoords/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ghostcoords.GhostCoordsClient"
    ]
  },
  "mixins": [
    {
      "config": "ghostcoords.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
